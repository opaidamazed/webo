<Project Sdk="Microsoft.NET.Sdk">

  <!-- Webo icon spike (D9): unpackaged, self-contained WinUI 3 app.
       Purpose: test how the app icon behaves in each Windows location. Not product code. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WeboIconSpike</RootNamespace>
    <AssemblyName>WeboIconSpike</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Unpackaged + self-contained: no MSIX identity, no separate runtime install -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Executable icon is fixed at build time to the default (dark) icon (decision D2) -->
    <ApplicationIcon>Assets\Brand\derived\icons\dark\webo-dark.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions are a starting point: let NuGet restore resolve/update them if a newer stable one exists. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240802000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icons must sit next to the exe as real files: AppWindow.SetIcon takes a file path to an .ico -->
    <Content Include="Assets\**\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
