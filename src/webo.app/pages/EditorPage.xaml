<Page
    x:Class="Webo.App.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Webo.App"
    xmlns:models="using:Webo.App.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar (requirements 5.1) -->
        <Border Style="{StaticResource WeboPanel}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Click="Back_Click" Padding="10,8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" MirroredWhenRightToLeft="True" />
                    </Button>
                    <StackPanel>
                        <TextBlock x:Name="ProjectName" Style="{StaticResource WeboHeadingText}" />
                        <TextBlock x:Name="SaveState" Style="{StaticResource WeboMutedText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ToggleButton x:Name="DevDesktop" Click="Device_Click" Tag="desktop" IsChecked="True">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                            <TextBlock x:Name="DevDesktopText" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="DevTablet" Click="Device_Click" Tag="tablet">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE70A;" FontSize="14" />
                            <TextBlock x:Name="DevTabletText" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="DevMobile" Click="Device_Click" Tag="mobile">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8EA;" FontSize="14" />
                            <TextBlock x:Name="DevMobileText" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="UndoBtn" IsEnabled="False" Padding="10,8" Click="Undo_Click">
                        <FontIcon Glyph="&#xE7A7;" FontSize="14" MirroredWhenRightToLeft="True" />
                    </Button>
                    <Button x:Name="RedoBtn" IsEnabled="False" Padding="10,8" Click="Redo_Click">
                        <FontIcon Glyph="&#xE7A6;" FontSize="14" MirroredWhenRightToLeft="True" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="TestBtn" IsEnabled="False" />
                    <Button x:Name="ExportBtn" IsEnabled="False" />
                    <Button x:Name="SaveBtn" Style="{StaticResource AccentButtonStyle}" Click="Save_Click">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Left panel: pages on top, sections of the selected page below -->
            <Border Style="{StaticResource WeboPanel}" BorderThickness="0,0,1,0" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PagesHeader" Style="{StaticResource WeboHeadingText}" VerticalAlignment="Center" />
                        <Button x:Name="AddPageBtn" Grid.Column="1" Click="AddPage_Click" Padding="10,8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                    </Grid>

                    <ListView x:Name="PagesList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="PagesList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PageDoc">
                                <Grid ColumnSpacing="8" Padding="2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE80F;" FontSize="14" Visibility="{x:Bind HomeVisibility, Mode=OneWay}"
                                              Foreground="{ThemeResource WeboAccentBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <TextBlock x:Name="SectionsHeader" Style="{StaticResource WeboHeadingText}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="AddSectionBtn" Padding="10,8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="AddSectionMenu" />
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="MoveUpBtn" Click="MoveUp_Click" Padding="10,8" IsEnabled="False">
                                <FontIcon Glyph="&#xE74A;" FontSize="14" />
                            </Button>
                            <Button x:Name="MoveDownBtn" Click="MoveDown_Click" Padding="10,8" IsEnabled="False">
                                <FontIcon Glyph="&#xE74B;" FontSize="14" />
                            </Button>
                            <Button x:Name="DupSectionBtn" Click="DupSection_Click" Padding="10,8" IsEnabled="False">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                            <Button x:Name="DelSectionBtn" Click="DelSection_Click" Padding="10,8" IsEnabled="False">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <ListView x:Name="SectionsList" Grid.Row="3" SelectionMode="Single"
                              SelectionChanged="SectionsList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SectionDoc">
                                <Grid ColumnSpacing="10" Padding="2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Center"
                                              Foreground="{ThemeResource WeboAccentBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind TypeLabel}" />
                                        <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource WeboMutedText}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Canvas: the real page, rendered by SiteRenderer inside WebView2 -->
            <Grid Grid.Column="1" Background="{ThemeResource WeboCanvasBrush}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                              VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" ZoomMode="Disabled">
                    <Grid Padding="20" HorizontalAlignment="Center">
                        <!-- LeftToRight here only isolates the WebView from the app's RTL; the site's own direction is set inside its HTML. -->
                        <Border x:Name="DeviceFrame" Width="1000" CornerRadius="12" FlowDirection="LeftToRight"
                                Background="White" BorderBrush="#33000000" BorderThickness="1">
                            <Grid>
                                <WebView2 x:Name="Preview" />
                                <TextBlock x:Name="PreviewError" Visibility="Collapsed" Margin="28" TextWrapping="Wrap"
                                           Foreground="#34406B" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Properties -->
            <Border Grid.Column="2" Style="{StaticResource WeboPanel}" BorderThickness="1,0,0,0" Padding="16">
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <TextBlock x:Name="PropsHeader" Style="{StaticResource WeboHeadingText}" />
                        <TextBox x:Name="TitleBox" TextChanged="TitleBox_TextChanged" MaxLength="80" />
                        <TextBox x:Name="SlugBox" LostFocus="SlugBox_LostFocus" FlowDirection="LeftToRight" MaxLength="60" />
                        <Button x:Name="SetHomeBtn" Click="SetHome_Click" HorizontalAlignment="Stretch" />
                        <Button x:Name="DeleteBtn" Click="DeletePage_Click" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="FolderText" Style="{StaticResource WeboMutedText}" FlowDirection="LeftToRight" TextWrapping="Wrap" />

                        <StackPanel x:Name="SectionPropsPanel" Spacing="12" Visibility="Collapsed">
                            <Border Height="1" Background="{ThemeResource WeboBorderBrush}" Margin="0,4,0,4" />
                            <TextBlock x:Name="SectionPropsHeader" Style="{StaticResource WeboHeadingText}" TextWrapping="Wrap" />
                            <StackPanel x:Name="SectionFields" Spacing="12" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
