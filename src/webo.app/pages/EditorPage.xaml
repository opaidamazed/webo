<Page
    x:Class="Webo.App.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar (requirements 5.1) -->
        <Border Style="{StaticResource WeboPanel}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Click="Back_Click" Padding="10,8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" MirroredWhenRightToLeft="True" />
                    </Button>
                    <StackPanel>
                        <TextBlock x:Name="ProjectName" Style="{StaticResource WeboHeadingText}" />
                        <TextBlock x:Name="SaveState" Style="{StaticResource WeboMutedText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ToggleButton x:Name="DevDesktop" Click="Device_Click" Tag="desktop" IsChecked="True">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                            <TextBlock x:Name="DevDesktopText" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="DevTablet" Click="Device_Click" Tag="tablet">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE70A;" FontSize="14" />
                            <TextBlock x:Name="DevTabletText" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="DevMobile" Click="Device_Click" Tag="mobile">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8EA;" FontSize="14" />
                            <TextBlock x:Name="DevMobileText" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="UndoBtn" IsEnabled="False" Padding="10,8">
                        <FontIcon Glyph="&#xE7A7;" FontSize="14" MirroredWhenRightToLeft="True" />
                    </Button>
                    <Button x:Name="RedoBtn" IsEnabled="False" Padding="10,8">
                        <FontIcon Glyph="&#xE7A6;" FontSize="14" MirroredWhenRightToLeft="True" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="TestBtn" IsEnabled="False" />
                    <Button x:Name="ExportBtn" IsEnabled="False" />
                    <Button x:Name="SaveBtn" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Pages panel -->
            <Border Style="{StaticResource WeboPanel}" BorderThickness="0,0,1,0" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PagesHeader" Style="{StaticResource WeboHeadingText}" VerticalAlignment="Center" />
                        <Button x:Name="AddPageBtn" Grid.Column="1" Click="AddPage_Click" Padding="10,8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                    </Grid>
                    <ListView x:Name="PagesList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="PagesList_SelectionChanged" />
                </Grid>
            </Border>

            <!-- Canvas: placeholder until the visual editor exists -->
            <Grid Grid.Column="1" Background="{ThemeResource WeboCanvasBrush}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto" ZoomMode="Disabled">
                    <Grid Padding="28" HorizontalAlignment="Center">
                        <Border x:Name="DeviceFrame" Width="1000" MinHeight="620" CornerRadius="14" RequestedTheme="Light"
                                Background="White" BorderBrush="#33000000" BorderThickness="1" VerticalAlignment="Top">
                            <StackPanel x:Name="SitePreview" Padding="30,22" Spacing="18">
                                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollMode="Disabled">
                                    <StackPanel x:Name="NavChips" Orientation="Horizontal" Spacing="20" />
                                </ScrollViewer>
                                <Border Height="1" Background="#14000000" />
                                <TextBlock x:Name="CanvasTitle" FontSize="34" FontFamily="{StaticResource WeboFontBold}"
                                           Foreground="#0B1033" TextWrapping="Wrap" />
                                <TextBlock x:Name="CanvasDir" FontSize="13" Foreground="#5A6482" />
                                <Border CornerRadius="12" Background="#F1F6FD" Padding="18" BorderBrush="#D6E6FA" BorderThickness="1">
                                    <TextBlock x:Name="CanvasNote" FontSize="14" Foreground="#34406B" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Properties -->
            <Border Grid.Column="2" Style="{StaticResource WeboPanel}" BorderThickness="1,0,0,0" Padding="16">
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <TextBlock x:Name="PropsHeader" Style="{StaticResource WeboHeadingText}" />
                        <TextBox x:Name="TitleBox" TextChanged="TitleBox_TextChanged" MaxLength="80" />
                        <TextBox x:Name="SlugBox" LostFocus="SlugBox_LostFocus" FlowDirection="LeftToRight" MaxLength="60" />
                        <Button x:Name="SetHomeBtn" Click="SetHome_Click" HorizontalAlignment="Stretch" />
                        <Button x:Name="DeleteBtn" Click="DeletePage_Click" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="FolderText" Style="{StaticResource WeboMutedText}" FlowDirection="LeftToRight" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
