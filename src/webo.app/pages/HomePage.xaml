<Page
    x:Class="Webo.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" Padding="36,24,36,40" Spacing="22" HorizontalAlignment="Center">

            <!-- Hero -->
            <Border CornerRadius="22" Padding="34,30">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#050A33" Offset="0" />
                        <GradientStop Color="#0B3C8F" Offset="0.62" />
                        <GradientStop Color="#1E88E5" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="10" VerticalAlignment="Center">
                        <TextBlock x:Name="WelcomeText" Style="{StaticResource WeboDisplayText}" Foreground="White" />
                        <TextBlock x:Name="SubText" FontSize="16" Foreground="#D6E6FF" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,14,0,0">
                            <Button Style="{StaticResource AccentButtonStyle}" Padding="22,11" CornerRadius="10"
                                    Click="New_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock x:Name="NewText" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Padding="22,11" CornerRadius="10" Click="Open_Click" Background="#26FFFFFF" BorderBrush="#55FFFFFF">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" Foreground="White" />
                                    <TextBlock x:Name="OpenText" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Image Grid.Column="1" Source="ms-appx:///Assets/Brand/derived/icons/dark/preview-256.png"
                           Width="132" Height="132" />
                </Grid>
            </Border>

            <!-- Honest status of this build -->
            <Border Style="{StaticResource WeboCard}" Padding="16,12" Background="{ThemeResource WeboAccentSoftBrush}">
                <TextBlock x:Name="HonestText" Style="{StaticResource WeboMutedText}"
                           Foreground="{ThemeResource WeboInkBrush}" />
            </Border>

            <TextBlock x:Name="RecentHeader" Style="{StaticResource WeboHeadingText}" />

            <Border x:Name="EmptyState" Style="{StaticResource WeboCard}" Padding="30">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource WeboHeadingText}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyBody" Style="{StaticResource WeboMutedText}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="RecentHost" Spacing="10" />

            <TextBlock x:Name="RemoveNote" Style="{StaticResource WeboMutedText}" />
        </StackPanel>
    </ScrollViewer>
</Page>
