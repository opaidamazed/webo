<Page
    x:Class="Webo.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Webo.App"
    xmlns:models="using:Webo.App.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" Padding="36,24,36,40" Spacing="22" HorizontalAlignment="Center">

            <!-- Hero -->
            <Border CornerRadius="22" Padding="34,30">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#050A33" Offset="0" />
                        <GradientStop Color="#0B3C8F" Offset="0.62" />
                        <GradientStop Color="#1E88E5" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind local:Loc.T('home.welcome')}"
                                   Style="{StaticResource WeboDisplayText}" Foreground="White" />
                        <TextBlock Text="{x:Bind local:Loc.T('home.sub')}" FontSize="16"
                                   Foreground="#D6E6FF" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,14,0,0">
                            <Button Style="{StaticResource AccentButtonStyle}" Padding="22,11" CornerRadius="10"
                                    Click="New_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="{x:Bind local:Loc.T('home.new')}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Padding="22,11" CornerRadius="10" Click="Open_Click" Background="#26FFFFFF" BorderBrush="#55FFFFFF">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" Foreground="White" />
                                    <TextBlock Text="{x:Bind local:Loc.T('home.open')}" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Image Grid.Column="1" Source="ms-appx:///Assets/Brand/derived/icons/dark/preview-256.png"
                           Width="132" Height="132" />
                </Grid>
            </Border>

            <!-- Honest status of this build -->
            <Border Style="{StaticResource WeboCard}" Padding="16,12" Background="{ThemeResource WeboAccentSoftBrush}">
                <TextBlock Text="{x:Bind local:Loc.T('home.honest')}" Style="{StaticResource WeboMutedText}"
                           Foreground="{ThemeResource WeboInkBrush}" />
            </Border>

            <TextBlock Text="{x:Bind local:Loc.T('home.recent')}" Style="{StaticResource WeboHeadingText}" />

            <Border x:Name="EmptyState" Style="{StaticResource WeboCard}" Padding="30">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Bind local:Loc.T('home.empty.title')}" Style="{StaticResource WeboHeadingText}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind local:Loc.T('home.empty.body')}" Style="{StaticResource WeboMutedText}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <ListView x:Name="RecentList" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="RecentList_ItemClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:RecentProject">
                        <Border Style="{StaticResource WeboCard}" Padding="16,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="12" Background="{ThemeResource WeboAccentSoftBrush}">
                                    <FontIcon Glyph="&#xE774;" FontSize="20" Foreground="{ThemeResource WeboAccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource WeboLabelText}" FontSize="16" />
                                    <TextBlock Text="{x:Bind TypeLabel}" Style="{StaticResource WeboMutedText}" />
                                    <TextBlock Text="{x:Bind Folder}" Style="{StaticResource WeboMutedText}"
                                               FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" Style="{StaticResource WeboMutedText}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="3" Tag="{x:Bind FilePath}" Click="Remove_Click" VerticalAlignment="Center"
                                        Padding="10,8" ToolTipService.ToolTip="{x:Bind local:Loc.T('home.remove')}">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="RemoveNote" Text="{x:Bind local:Loc.T('home.remove.note')}"
                       Style="{StaticResource WeboMutedText}" />
        </StackPanel>
    </ScrollViewer>
</Page>
