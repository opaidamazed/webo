<Page
    x:Class="Webo.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Padding="36,24,36,40" Spacing="18" HorizontalAlignment="Stretch">

            <TextBlock x:Name="TitleText" Style="{StaticResource WeboDisplayText}" />

            <!-- Appearance -->
            <Border Style="{StaticResource WeboCard}">
                <StackPanel Spacing="18">
                    <TextBlock x:Name="AppearanceHeader" Style="{StaticResource WeboHeadingText}" />

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="LangLabel" Style="{StaticResource WeboLabelText}" />
                        <RadioButtons x:Name="LangChoice" MaxColumns="2" SelectionChanged="LangChoice_SelectionChanged" />
                        <TextBlock x:Name="LangNote" Style="{StaticResource WeboMutedText}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ThemeLabel" Style="{StaticResource WeboLabelText}" />
                        <RadioButtons x:Name="ThemeChoice" MaxColumns="3" SelectionChanged="ThemeChoice_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- App icon: no choice to make. Outside the app it is always the dark original; inside the app it follows the theme. -->
            <Border Style="{StaticResource WeboCard}">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="IconHeader" Style="{StaticResource WeboHeadingText}" />
                    <TextBlock x:Name="IconNote" Style="{StaticResource WeboMutedText}" />
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image x:Name="InAppIconImage" Width="56" Height="56" />
                        <TextBlock x:Name="InAppIconLabel" Style="{StaticResource WeboLabelText}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Shortcuts (decision D3: consent first, only our own shortcuts) -->
            <Border Style="{StaticResource WeboCard}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="ScTitle" Style="{StaticResource WeboHeadingText}" />
                    <TextBlock x:Name="ScNote" Style="{StaticResource WeboMutedText}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ScDesktopBtn" Click="DesktopShortcut_Click" />
                        <Button x:Name="ScStartBtn" Click="StartShortcut_Click" />
                    </StackPanel>
                    <InfoBar x:Name="ShortcutStatus" IsOpen="False" IsClosable="False" Severity="Informational" />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource WeboCard}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="AboutHeader" Style="{StaticResource WeboHeadingText}" />
                    <TextBlock x:Name="AboutText" Style="{StaticResource WeboMutedText}" />
                    <TextBlock x:Name="DataText" Style="{StaticResource WeboMutedText}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
